<view class="order-detail-container">
  <!-- 订单状态 -->
  <view class="status-section">
    <view class="status-icon">📦</view>
    <view class="status-info">
      <text class="status-text">{{order.statusText}}</text>
      <text class="status-desc">{{order.statusDesc}}</text>
    </view>
  </view>

  <!-- 物流信息 -->
  <view class="logistics-section" wx:if="{{order.trackingNo}}" bindtap="viewLogistics">
    <view class="logistics-icon">🚚</view>
    <view class="logistics-info">
      <text class="logistics-status">运输中</text>
      <text class="logistics-detail">{{order.logisticsComp}} {{order.trackingNo}}</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <!-- 收货地址 -->
  <view class="address-section">
    <view class="address-icon">📍</view>
    <view class="address-info">
      <view class="address-user">
        <text class="user-name">{{order.address?.name}}</text>
        <text class="user-phone">{{order.address?.phone}}</text>
      </view>
      <text class="address-detail">{{order.address?.fullAddress}}</text>
    </view>
  </view>

  <!-- 商品信息 -->
  <view class="goods-section">
    <view class="shop-name">无艺商城</view>
    <view class="goods-item" bindtap="goToProduct" data-id="{{order.productId}}">
      <image class="goods-image" src="{{order.productImage}}" mode="aspectFill"/>
      <view class="goods-info">
        <text class="goods-title text-ellipsis-2">{{order.productTitle}}</text>
        <text class="goods-price">¥{{order.price}}</text>
        <text class="goods-count">x{{order.quantity}}</text>
      </view>
    </view>
    <view class="goods-total">
      <text>共{{order.quantity}}件商品 合计:</text>
      <text class="total-price">¥{{order.totalAmount}}</text>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="order-info-section">
    <view class="info-title">订单信息</view>
    <view class="info-item">
      <text class="info-label">订单编号</text>
      <text class="info-value">{{order.orderNo}}</text>
      <text class="copy-btn" bindtap="copyOrderNo">复制</text>
    </view>
    <view class="info-item">
      <text class="info-label">创建时间</text>
      <text class="info-value">{{order.createTime}}</text>
    </view>
    <view class="info-item" wx:if="{{order.payTime}}">
      <text class="info-label">付款时间</text>
      <text class="info-value">{{order.payTime}}</text>
    </view>
    <view class="info-item" wx:if="{{order.shipTime}}">
      <text class="info-label">发货时间</text>
      <text class="info-value">{{order.shipTime}}</text>
    </view>
  </view>

  <!-- 价格明细 -->
  <view class="price-section">
    <view class="price-item">
      <text>商品总价</text>
      <text>¥{{order.goodsAmount}}</text>
    </view>
    <view class="price-item">
      <text>运费</text>
      <text>¥{{order.freightAmount || 0}}</text>
    </view>
    <view class="price-item">
      <text>保证金</text>
      <text>¥{{order.depositAmount}}</text>
    </view>
    <view class="price-item total">
      <text>实付款</text>
      <text class="total-amount">¥{{order.totalAmount}}</text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar safe-area-bottom">
    <block wx:if="{{order.status === 0}}">
      <button class="btn btn-default" bindtap="cancelOrder">取消订单</button>
      <button class="btn btn-primary" bindtap="payOrder">立即付款</button>
    </block>
    <block wx:if="{{order.status === 2}}">
      <button class="btn btn-default" bindtap="viewLogistics">查看物流</button>
      <button class="btn btn-primary" bindtap="confirmReceive">确认收货</button>
    </block>
    <block wx:if="{{order.status === 3}}">
      <button class="btn btn-default" bindtap="applyAfterSale">申请售后</button>
      <button class="btn btn-primary" bindtap="goToReview">评价</button>
    </block>
    <block wx:if="{{order.status === 4}}">
      <button class="btn btn-default" bindtap="deleteOrder">删除订单</button>
      <button class="btn btn-primary" bindtap="buyAgain">再次购买</button>
    </block>
  </view>
</view>
