.order-detail-container {
  padding-bottom: 140rpx;
  background: #f8f8f8;
  min-height: 100vh;
}

/* 订单状态 */
.status-section {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #d81e06, #ff6b6b);
  padding: 60rpx 40rpx;
  color: #fff;
}

.status-icon {
  font-size: 80rpx;
  margin-right: 30rpx;
}

.status-info {
  flex: 1;
}

.status-text {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.status-desc {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 物流信息 */
.logistics-section {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
}

.logistics-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.logistics-info {
  flex: 1;
}

.logistics-status {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.logistics-detail {
  font-size: 26rpx;
  color: #999;
}

.logistics-section .arrow {
  font-size: 40rpx;
  color: #ccc;
}

/* 收货地址 */
.address-section {
  display: flex;
  align-items: flex-start;
  background: #fff;
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
}

.address-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  margin-top: 4rpx;
}

.address-info {
  flex: 1;
}

.address-user {
  margin-bottom: 12rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 24rpx;
}

.user-phone {
  font-size: 30rpx;
  color: #666;
}

.address-detail {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

/* 商品信息 */
.goods-section {
  background: #fff;
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
}

.shop-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.goods-item {
  display: flex;
  padding: 20rpx 0;
  border-top: 2rpx solid #f5f5f5;
  border-bottom: 2rpx solid #f5f5f5;
}

.goods-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: #f5f5f5;
}

.goods-info {
  flex: 1;
  position: relative;
}

.goods-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.goods-price {
  font-size: 30rpx;
  color: #d81e06;
  font-weight: bold;
}

.goods-count {
  position: absolute;
  right: 0;
  bottom: 0;
  font-size: 28rpx;
  color: #999;
}

.goods-total {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding-top: 20rpx;
  font-size: 28rpx;
  color: #666;
}

.total-price {
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
  margin-left: 12rpx;
}

/* 订单信息 */
.order-info-section {
  background: #fff;
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
}

.info-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.info-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.info-label {
  color: #999;
  width: 160rpx;
}

.info-value {
  color: #666;
  flex: 1;
}

.copy-btn {
  padding: 8rpx 20rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
  margin-left: 20rpx;
}

/* 价格明细 */
.price-section {
  background: #fff;
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
}

.price-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #666;
}

.price-item.total {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f5f5f5;
  font-size: 32rpx;
  color: #333;
}

.total-amount {
  color: #d81e06;
  font-weight: bold;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  background: #fff;
  padding: 20rpx 30rpx;
  border-top: 2rpx solid #f0f0f0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.bottom-bar .btn {
  margin: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 40rpx;
  font-size: 28rpx;
  border-radius: 36rpx;
}
