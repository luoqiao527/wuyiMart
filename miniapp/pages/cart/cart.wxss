.cart-container {
  min-height: 100vh;
  background: #f8f8f8;
}

/* 空购物车 */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  background: #e0e0e0;
  border-radius: 50%;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.empty-cart .btn {
  width: 240rpx;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
}

/* 购物车列表 */
.cart-list {
  height: calc(100vh - 120rpx);
  padding: 20rpx;
  box-sizing: border-box;
}

.cart-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.item-check {
  margin-right: 20rpx;
}

.item-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: #f5f5f5;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.item-spec {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-price {
  font-size: 32rpx;
  font-weight: bold;
}

.quantity-control {
  display: flex;
  align-items: center;
  border: 2rpx solid #e5e5e5;
  border-radius: 8rpx;
  overflow: hidden;
}

.control-btn {
  width: 56rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 32rpx;
  color: #666;
  background: #f5f5f5;
}

.control-btn.disabled {
  color: #ccc;
}

.quantity-input {
  width: 72rpx;
  height: 48rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
  border-left: 2rpx solid #e5e5e5;
  border-right: 2rpx solid #e5e5e5;
}

.delete-btn {
  font-size: 36rpx;
  padding: 20rpx;
  margin-left: 10rpx;
}

/* 底部结算栏 */
.cart-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 20rpx 30rpx;
  border-top: 2rpx solid #f0f0f0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.footer-left {
  display: flex;
  align-items: center;
}

.select-all {
  font-size: 28rpx;
  color: #666;
  margin-left: 12rpx;
  margin-right: 30rpx;
}

.total-price {
  display: flex;
  align-items: center;
}

.total-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 8rpx;
}

.total-price .price {
  font-size: 40rpx;
  font-weight: bold;
}

.settle-btn {
  width: 200rpx;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
}
