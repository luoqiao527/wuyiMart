.product-detail-container {
  padding-bottom: 120rpx;
}

/* 商品轮播图 */
.product-swiper {
  height: 750rpx;
}

.product-image {
  width: 100%;
  height: 100%;
}

/* 拍卖信息 */
.auction-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(90deg, #d81e06, #ff6b6b);
  padding: 24rpx 30rpx;
  color: #fff;
}

.auction-status {
  display: flex;
  align-items: center;
}

.status-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.status-text {
  font-size: 32rpx;
  font-weight: bold;
}

.auction-countdown {
  display: flex;
  align-items: center;
}

.countdown-label {
  font-size: 24rpx;
  margin-right: 12rpx;
  opacity: 0.9;
}

.countdown-time {
  font-size: 32rpx;
  font-weight: bold;
  font-family: monospace;
}

/* 价格区域 */
.price-section {
  background: #fff;
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.current-price {
  display: flex;
  align-items: baseline;
  color: #d81e06;
}

.price-symbol {
  font-size: 36rpx;
  font-weight: bold;
  margin-right: 4rpx;
}

.price-value {
  font-size: 56rpx;
  font-weight: bold;
}

.price-info {
  display: flex;
  margin-top: 16rpx;
}

.start-price, .increment {
  font-size: 26rpx;
  color: #999;
  margin-right: 30rpx;
}

/* 标题区域 */
.title-section {
  background: #fff;
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.product-title {
  font-size: 34rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.product-tags {
  display: flex;
  flex-wrap: wrap;
}

.product-tags .tag {
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

/* 统计区域 */
.stats-section {
  display: flex;
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
  border-right: 2rpx solid #f0f0f0;
}

.stat-item:last-child {
  border-right: none;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

/* 详情区域 */
.detail-section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-left: 20rpx;
  border-left: 6rpx solid #d81e06;
}

.detail-content {
  font-size: 30rpx;
  color: #666;
  line-height: 1.8;
}

/* 出价记录 */
.bid-section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.bid-list {
  border-top: 2rpx solid #f0f0f0;
}

.bid-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.bid-user {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #f0f0f0;
}

.user-name {
  font-size: 28rpx;
  color: #333;
}

.bid-info {
  text-align: right;
}

.bid-price {
  display: block;
  font-size: 32rpx;
  color: #d81e06;
  font-weight: bold;
  margin-bottom: 4rpx;
}

.bid-time {
  font-size: 24rpx;
  color: #999;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 30rpx;
  border-top: 2rpx solid #f0f0f0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.action-icons {
  display: flex;
  margin-right: 30rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 40rpx;
}

.action-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.action-text {
  font-size: 22rpx;
  color: #666;
}

.action-buttons {
  flex: 1;
}

.action-btn {
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
}

.action-btn.disabled {
  background: #ccc;
}

/* 出价弹窗 */
.bid-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.popup-content {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.popup-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.popup-close {
  font-size: 48rpx;
  color: #999;
  padding: 10rpx;
}

.popup-body {
  margin-bottom: 40rpx;
}

.bid-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.info-label {
  font-size: 30rpx;
  color: #666;
}

.info-value {
  font-size: 32rpx;
  font-weight: bold;
}

.bid-input-row {
  margin: 40rpx 0;
}

.input-label {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.input-wrap {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
}

.input-symbol {
  font-size: 40rpx;
  color: #333;
  margin-right: 16rpx;
}

.bid-input {
  flex: 1;
  height: 56rpx;
  font-size: 48rpx;
  font-weight: bold;
  color: #d81e06;
}

.bid-tip {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-top: 16rpx;
}

.popup-footer {
  display: flex;
  gap: 20rpx;
}

.popup-footer .btn {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
}
