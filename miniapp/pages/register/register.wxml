<view class="register-container">
  <!-- 注册类型切换 -->
  <view class="register-type">
    <view 
      class="type-item {{registerType === 'user' ? 'active' : ''}}" 
      bindtap="switchType"
      data-type="user"
    >
      用户注册
    </view>
    <view 
      class="type-item {{registerType === 'merchant' ? 'active' : ''}}" 
      bindtap="switchType"
      data-type="merchant"
    >
      商家入驻
    </view>
  </view>

  <!-- 用户注册表单 -->
  <block wx:if="{{registerType === 'user'}}">
    <view class="form-section">
      <view class="form-item">
        <text class="label">用户名</text>
        <input 
          class="input" 
          placeholder="请输入用户名" 
          value="{{userForm.username}}"
          bindinput="onInput"
          data-field="userForm.username"
        />
      </view>

      <view class="form-item">
        <text class="label">密码</text>
        <input 
          class="input" 
          type="password"
          placeholder="请输入密码（至少6位）" 
          value="{{userForm.password}}"
          bindinput="onInput"
          data-field="userForm.password"
        />
      </view>

      <view class="form-item">
        <text class="label">确认密码</text>
        <input 
          class="input" 
          type="password"
          placeholder="请再次输入密码" 
          value="{{userForm.confirmPassword}}"
          bindinput="onInput"
          data-field="userForm.confirmPassword"
        />
      </view>

      <view class="form-item">
        <text class="label">手机号</text>
        <input 
          class="input" 
          type="number"
          maxlength="11"
          placeholder="请输入手机号" 
          value="{{userForm.phone}}"
          bindinput="onInput"
          data-field="userForm.phone"
        />
      </view>

      <view class="form-item">
        <text class="label">邮箱</text>
        <input 
          class="input" 
          type="text"
          placeholder="请输入邮箱（选填）" 
          value="{{userForm.email}}"
          bindinput="onInput"
          data-field="userForm.email"
        />
      </view>
    </view>
  </block>

  <!-- 商家入驻表单 -->
  <block wx:if="{{registerType === 'merchant'}}">
    <view class="form-section">
      <view class="form-item">
        <text class="label">登录账号</text>
        <input 
          class="input" 
          placeholder="请输入登录账号" 
          value="{{merchantForm.username}}"
          bindinput="onInput"
          data-field="merchantForm.username"
        />
      </view>

      <view class="form-item">
        <text class="label">密码</text>
        <input 
          class="input" 
          type="password"
          placeholder="请输入密码（至少6位）" 
          value="{{merchantForm.password}}"
          bindinput="onInput"
          data-field="merchantForm.password"
        />
      </view>

      <view class="form-item">
        <text class="label">确认密码</text>
        <input 
          class="input" 
          type="password"
          placeholder="请再次输入密码" 
          value="{{merchantForm.confirmPassword}}"
          bindinput="onInput"
          data-field="merchantForm.confirmPassword"
        />
      </view>

      <view class="form-item">
        <text class="label">手机号</text>
        <input 
          class="input" 
          type="number"
          maxlength="11"
          placeholder="请输入手机号" 
          value="{{merchantForm.phone}}"
          bindinput="onInput"
          data-field="merchantForm.phone"
        />
      </view>

      <view class="form-item">
        <text class="label">真实姓名</text>
        <input 
          class="input" 
          placeholder="请输入真实姓名" 
          value="{{merchantForm.realName}}"
          bindinput="onInput"
          data-field="merchantForm.realName"
        />
      </view>

      <view class="form-item">
        <text class="label">身份证号</text>
        <input 
          class="input" 
          maxlength="18"
          placeholder="请输入身份证号" 
          value="{{merchantForm.idCard}}"
          bindinput="onInput"
          data-field="merchantForm.idCard"
        />
      </view>

      <view class="form-item">
        <text class="label">店铺名称</text>
        <input 
          class="input" 
          placeholder="请输入店铺名称" 
          value="{{merchantForm.shopName}}"
          bindinput="onInput"
          data-field="merchantForm.shopName"
        />
      </view>
    </view>
  </block>

  <!-- 注册按钮 -->
  <button class="btn btn-primary register-btn" bindtap="handleRegister" loading="{{loading}}">
    {{registerType === 'user' ? '立即注册' : '提交入驻申请'}}
  </button>

  <!-- 提示信息 -->
  <view class="tips" wx:if="{{registerType === 'merchant'}}">
    <text class="tip-text">提交入驻申请后，需要等待平台管理员审核通过才能发布商品</text>
  </view>

  <!-- 已有账号 -->
  <view class="has-account">
    <text>已有账号？</text>
    <text class="link" bindtap="goToLogin">立即登录</text>
  </view>
</view>
