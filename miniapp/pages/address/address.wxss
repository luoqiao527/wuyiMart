.address-container {
  min-height: 100vh;
  background: #f8f8f8;
  padding-bottom: 140rpx;
}

/* 地址列表 */
.address-list {
  padding: 20rpx;
}

.address-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.address-info {
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 24rpx;
}

.user-phone {
  font-size: 30rpx;
  color: #666;
  margin-right: 16rpx;
}

.default-tag {
  padding: 4rpx 12rpx;
  background: rgba(216, 30, 6, 0.1);
  color: #d81e06;
  font-size: 22rpx;
  border-radius: 6rpx;
}

.address-detail {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

.address-actions {
  display: flex;
  justify-content: flex-end;
  gap: 30rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f5f5f5;
}

.action-btn {
  font-size: 28rpx;
  color: #666;
  padding: 10rpx 20rpx;
}

.action-btn.delete {
  color: #d81e06;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  background: #e0e0e0;
  border-radius: 50%;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
}

/* 添加按钮 */
.add-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 40rpx;
  background: #fff;
  border-top: 2rpx solid #f0f0f0;
}

.add-btn {
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 34rpx;
}

/* 地址编辑弹窗 */
.address-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.popup-content {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.popup-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.popup-close {
  font-size: 48rpx;
  color: #999;
  padding: 10rpx;
}

.popup-body {
  margin-bottom: 40rpx;
}

.form-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.form-item.checkbox-item {
  justify-content: space-between;
  align-items: center;
}

.form-label {
  width: 160rpx;
  font-size: 30rpx;
  color: #333;
  padding-top: 8rpx;
}

.form-input {
  flex: 1;
  height: 48rpx;
  font-size: 30rpx;
  color: #333;
}

.form-input::placeholder {
  color: #bbb;
}

.picker-value {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  padding-top: 8rpx;
}

.picker-value.placeholder {
  color: #bbb;
}

.form-textarea {
  flex: 1;
  height: 120rpx;
  font-size: 30rpx;
  color: #333;
  line-height: 1.5;
}

.form-textarea::placeholder {
  color: #bbb;
}

.popup-footer .save-btn {
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 34rpx;
}
