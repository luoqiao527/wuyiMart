<view class="address-container">
  <!-- 地址列表 -->
  <view class="address-list" wx:if="{{addresses.length > 0}}">
    <view class="address-item" wx:for="{{addresses}}" wx:key="id">
      <view class="address-info" bindtap="selectAddress" data-item="{{item}}">
        <view class="user-info">
          <text class="user-name">{{item.name}}</text>
          <text class="user-phone">{{item.phone}}</text>
          <text class="default-tag" wx:if="{{item.isDefault}}">默认</text>
        </view>
        <text class="address-detail">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</text>
      </view>
      <view class="address-actions">
        <text class="action-btn" bindtap="editAddress" data-item="{{item}}">编辑</text>
        <text class="action-btn delete" bindtap="deleteAddress" data-id="{{item.id}}">删除</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <image class="empty-icon" src="/images/empty-address.png" mode="aspectFit"/>
    <text class="empty-text">暂无收货地址</text>
  </view>

  <!-- 添加按钮 -->
  <view class="add-section safe-area-bottom">
    <button class="btn btn-primary add-btn" bindtap="addAddress">+ 新建收货地址</button>
  </view>

  <!-- 地址编辑弹窗 -->
  <view class="address-popup" wx:if="{{showPopup}}" bindtap="closePopup">
    <view class="popup-content" catchtap="preventClose">
      <view class="popup-header">
        <text class="popup-title">{{isEdit ? '编辑地址' : '新建地址'}}</text>
        <text class="popup-close" bindtap="closePopup">×</text>
      </view>
      <view class="popup-body">
        <view class="form-item">
          <text class="form-label">收货人</text>
          <input class="form-input" placeholder="请输入收货人姓名" value="{{form.name}}" bindinput="onNameInput"/>
        </view>
        <view class="form-item">
          <text class="form-label">手机号</text>
          <input class="form-input" type="number" placeholder="请输入手机号" value="{{form.phone}}" bindinput="onPhoneInput"/>
        </view>
        <view class="form-item">
          <text class="form-label">所在地区</text>
          <picker mode="region" bindchange="onRegionChange" value="{{[form.province, form.city, form.district]}}">
            <view class="picker-value {{form.province ? '' : 'placeholder'}}">
              {{form.province ? form.province + ' ' + form.city + ' ' + form.district : '请选择所在地区'}}
            </view>
          </picker>
        </view>
        <view class="form-item">
          <text class="form-label">详细地址</text>
          <textarea class="form-textarea" placeholder="请输入详细地址，如街道、门牌号等" value="{{form.detail}}" bindinput="onDetailInput"/>
        </view>
        <view class="form-item checkbox-item">
          <text class="form-label">设为默认地址</text>
          <switch checked="{{form.isDefault}}" bindchange="onDefaultChange"/>
        </view>
      </view>
      <view class="popup-footer">
        <button class="btn btn-primary save-btn" bindtap="saveAddress">保存</button>
      </view>
    </view>
  </view>
</view>
