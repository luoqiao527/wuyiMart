.favorites-container {
  min-height: 100vh;
  background: #f8f8f8;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  background: #e0e0e0;
  border-radius: 50%;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.empty-state .btn {
  width: 240rpx;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
}

/* 收藏列表 */
.favorites-list {
  height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
}

.favorite-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.item-content {
  display: flex;
  margin-bottom: 20rpx;
}

.item-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: #f5f5f5;
}

.item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-title {
  font-size: 30rpx;
  color: #333;
  line-height: 1.4;
}

.item-price-row {
  display: flex;
  align-items: baseline;
  margin: 16rpx 0;
}

.item-price {
  font-size: 36rpx;
  font-weight: bold;
}

.item-original {
  font-size: 26rpx;
  margin-left: 16rpx;
}

.item-tags {
  display: flex;
  flex-wrap: wrap;
}

.item-tags .tag {
  margin-right: 12rpx;
}

/* 操作按钮 */
.item-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f5f5f5;
}

.action-btn {
  padding: 12rpx 32rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #666;
  background: #fff;
}

.action-btn.primary {
  background: #d81e06;
  color: #fff;
  border-color: #d81e06;
}

/* 加载状态 */
.load-status {
  text-align: center;
  padding: 40rpx;
  font-size: 26rpx;
  color: #999;
}
