.user-container {
  padding: 20rpx;
  padding-bottom: 40rpx;
}

/* 用户信息卡片 */
.user-card {
  background: linear-gradient(135deg, #d81e06, #ff6b6b);
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
  color: #fff;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  margin-right: 24rpx;
  background: #fff;
}

.user-meta {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.user-phone {
  font-size: 26rpx;
  opacity: 0.9;
}

.user-info .arrow {
  font-size: 40rpx;
  opacity: 0.8;
}

/* 用户统计 */
.user-stats {
  display: flex;
  justify-content: space-around;
  padding-top: 30rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.2);
}

.stat-item {
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 菜单卡片 */
.menu-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.header-more {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #999;
}

.header-more .arrow {
  margin-left: 4rpx;
  font-size: 32rpx;
}

/* 订单类型 */
.order-types {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 0;
}

.type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.type-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.type-name {
  font-size: 26rpx;
  color: #666;
}

.type-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: #d81e06;
  color: #fff;
  font-size: 22rpx;
  border-radius: 16rpx;
  text-align: center;
  line-height: 32rpx;
  padding: 0 8rpx;
}

/* 菜单列表 */
.menu-list {
  padding: 10rpx 0;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-name {
  font-size: 30rpx;
  color: #333;
}

.menu-item .arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* 退出登录 */
.logout-section {
  margin-top: 40rpx;
  padding: 0 30rpx;
}

.logout-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #fff;
  color: #d81e06;
  font-size: 32rpx;
  border-radius: 48rpx;
  border: 2rpx solid #d81e06;
}

.logout-btn::after {
  border: none;
}

/* 登录按钮 */
.login-section {
  margin-top: 60rpx;
  padding: 0 60rpx;
}

.login-btn {
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 34rpx;
}
