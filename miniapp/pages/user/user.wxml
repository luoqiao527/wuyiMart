<view class="user-container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-info" bindtap="goToProfile">
      <image class="user-avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill"/>
      <view class="user-meta">
        <text class="user-name">{{userInfo.username || '未登录'}}</text>
        <text class="user-phone" wx:if="{{userInfo.phone}}">{{userInfo.phone}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
    
    <!-- 用户统计 -->
    <view class="user-stats">
      <view class="stat-item" bindtap="goToFavorites">
        <text class="stat-num">{{stats.favorites}}</text>
        <text class="stat-label">收藏</text>
      </view>
      <view class="stat-item" bindtap="goToOrders" data-status="0">
        <text class="stat-num">{{stats.orders}}</text>
        <text class="stat-label">订单</text>
      </view>
      <view class="stat-item" bindtap="goToAuction">
        <text class="stat-num">{{stats.auctions}}</text>
        <text class="stat-label">竞拍</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{stats.coupons}}</text>
        <text class="stat-label">优惠券</text>
      </view>
    </view>
  </view>

  <!-- 我的订单 -->
  <view class="menu-card">
    <view class="card-header" bindtap="goToOrders">
      <text class="header-title">我的订单</text>
      <view class="header-more">
        <text>查看全部</text>
        <text class="arrow">›</text>
      </view>
    </view>
    <view class="order-types">
      <view class="type-item" bindtap="goToOrders" data-status="1">
        <text class="type-icon">⏳</text>
        <text class="type-name">待付款</text>
        <text class="type-badge" wx:if="{{orderCount.pendingPay > 0}}">{{orderCount.pendingPay}}</text>
      </view>
      <view class="type-item" bindtap="goToOrders" data-status="2">
        <text class="type-icon">📦</text>
        <text class="type-name">待发货</text>
        <text class="type-badge" wx:if="{{orderCount.pendingShip > 0}}">{{orderCount.pendingShip}}</text>
      </view>
      <view class="type-item" bindtap="goToOrders" data-status="3">
        <text class="type-icon">🚚</text>
        <text class="type-name">待收货</text>
        <text class="type-badge" wx:if="{{orderCount.pendingReceive > 0}}">{{orderCount.pendingReceive}}</text>
      </view>
      <view class="type-item" bindtap="goToOrders" data-status="4">
        <text class="type-icon">💬</text>
        <text class="type-name">待评价</text>
        <text class="type-badge" wx:if="{{orderCount.pendingReview > 0}}">{{orderCount.pendingReview}}</text>
      </view>
      <view class="type-item" bindtap="goToAfterSales">
        <text class="type-icon">🔧</text>
        <text class="type-name">售后</text>
        <text class="type-badge" wx:if="{{orderCount.afterSales > 0}}">{{orderCount.afterSales}}</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-card">
    <view class="menu-list">
      <view class="menu-item" bindtap="goToAddress">
        <view class="menu-left">
          <text class="menu-icon">📍</text>
          <text class="menu-name">收货地址</text>
        </view>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToFavorites">
        <view class="menu-left">
          <text class="menu-icon">❤️</text>
          <text class="menu-name">我的收藏</text>
        </view>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToAuction">
        <view class="menu-left">
          <text class="menu-icon">🔨</text>
          <text class="menu-name">我的竞拍</text>
        </view>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToHistory">
        <view class="menu-left">
          <text class="menu-icon">👁️</text>
          <text class="menu-name">浏览记录</text>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 服务中心 -->
  <view class="menu-card">
    <view class="card-header">
      <text class="header-title">服务中心</text>
    </view>
    <view class="menu-list">
      <view class="menu-item" bindtap="contactService">
        <view class="menu-left">
          <text class="menu-icon">💁</text>
          <text class="menu-name">联系客服</text>
        </view>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="showHelp">
        <view class="menu-left">
          <text class="menu-icon">❓</text>
          <text class="menu-name">帮助中心</text>
        </view>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="showAbout">
        <view class="menu-left">
          <text class="menu-icon">ℹ️</text>
          <text class="menu-name">关于我们</text>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section" wx:if="{{isLoggedIn}}">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>

  <!-- 登录按钮 -->
  <view class="login-section" wx:if="{{!isLoggedIn}}">
    <button class="btn btn-primary login-btn" bindtap="goToLogin">立即登录</button>
  </view>
</view>
