<view class="order-list-container">
  <!-- 状态标签 -->
  <scroll-view class="status-tabs" scroll-x="true">
    <view 
      class="tab-item {{currentStatus === item.value ? 'active' : ''}}" 
      wx:for="{{statusTabs}}" 
      wx:key="value"
      bindtap="switchStatus"
      data-status="{{item.value}}"
    >
      {{item.label}}
    </view>
  </scroll-view>

  <!-- 订单列表 -->
  <scroll-view class="order-list" scroll-y="true" bindscrolltolower="loadMore" refresher-enabled="true" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
    <view class="order-item" wx:for="{{orders}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="order-header">
        <text class="order-no">订单号: {{item.orderNo}}</text>
        <text class="order-status {{item.statusClass}}">{{item.statusText}}</text>
      </view>
      
      <view class="order-goods">
        <image class="goods-image" src="{{item.productImage}}" mode="aspectFill"/>
        <view class="goods-info">
          <text class="goods-title text-ellipsis-2">{{item.productTitle}}</text>
          <text class="goods-price">¥{{item.price}}</text>
        </view>
        <text class="goods-count">x{{item.quantity}}</text>
      </view>
      
      <view class="order-footer">
        <text class="order-time">{{item.createTime}}</text>
        <view class="order-total">
          <text>共{{item.quantity}}件 合计:</text>
          <text class="total-price">¥{{item.totalAmount}}</text>
        </view>
      </view>
      
      <view class="order-actions">
        <block wx:if="{{item.status === 1}}">
          <button class="btn btn-default btn-small" bindtap="cancelOrder" data-id="{{item.id}}" catchtap>取消订单</button>
          <button class="btn btn-primary btn-small" bindtap="payOrder" data-id="{{item.id}}" catchtap>立即付款</button>
        </block>
        <block wx:if="{{item.status === 3}}">
          <button class="btn btn-default btn-small" bindtap="viewLogistics" data-id="{{item.id}}" catchtap>查看物流</button>
          <button class="btn btn-primary btn-small" bindtap="confirmReceive" data-id="{{item.id}}" catchtap>确认收货</button>
        </block>
        <block wx:if="{{item.status === 4}}">
          <button class="btn btn-default btn-small" bindtap="applyAfterSale" data-id="{{item.id}}" catchtap>申请售后</button>
          <button class="btn btn-primary btn-small" bindtap="goToReview" data-id="{{item.id}}" catchtap>评价</button>
        </block>
      </view>
    </view>

    <!-- 加载状态 -->
    <view class="load-status">
      <text wx:if="{{loading}}">加载中...</text>
      <text wx:elif="{{noMore}}">没有更多了</text>
      <text wx:elif="{{orders.length === 0}}">暂无订单</text>
    </view>
  </scroll-view>
</view>
