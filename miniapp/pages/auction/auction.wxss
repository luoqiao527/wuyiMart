.auction-container {
  min-height: 100vh;
  background: #f8f8f8;
}

/* 拍卖标签 */
.auction-tabs {
  display: flex;
  background: #fff;
  padding: 0 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
  transition: all 0.3s;
}

.tab-item.active {
  color: #d81e06;
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #d81e06;
  border-radius: 2rpx;
}

/* 拍卖列表 */
.auction-list {
  height: calc(100vh - 100rpx);
  padding: 20rpx;
  box-sizing: border-box;
}

.auction-item {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.item-image-wrap {
  position: relative;
  width: 100%;
  height: 400rpx;
  overflow: hidden;
}

.item-image {
  width: 100%;
  height: 100%;
}

.item-status {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.6);
}

.item-status.bidding {
  background: #d81e06;
}

.item-status.upcoming {
  background: #1890ff;
}

.item-status.ended {
  background: #999;
}

.countdown-badge {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.7);
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
}

.countdown-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.countdown-text {
  font-size: 26rpx;
  color: #fff;
  font-family: monospace;
}

/* 商品信息 */
.item-info {
  padding: 24rpx;
}

.item-title {
  font-size: 32rpx;
  color: #333;
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.item-price-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 16rpx;
}

.current-price .price-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.current-price .price-value {
  font-size: 44rpx;
  font-weight: bold;
}

.start-price {
  text-align: right;
}

.start-price .price-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.start-price .price-value {
  font-size: 28rpx;
  color: #666;
}

.item-meta {
  display: flex;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 2rpx solid #f5f5f5;
}

.bid-count {
  font-size: 26rpx;
  color: #666;
}

.increment {
  font-size: 26rpx;
  color: #999;
}

/* 加载状态 */
.load-status {
  text-align: center;
  padding: 40rpx;
  font-size: 26rpx;
  color: #999;
}
