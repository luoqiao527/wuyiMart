<view class="auction-container">
  <!-- 拍卖标签 -->
  <view class="auction-tabs">
    <view 
      class="tab-item {{currentTab === item.value ? 'active' : ''}}" 
      wx:for="{{tabs}}" 
      wx:key="value"
      bindtap="switchTab"
      data-tab="{{item.value}}"
    >
      {{item.label}}
    </view>
  </view>

  <!-- 拍卖列表 -->
  <scroll-view class="auction-list" scroll-y="true" bindscrolltolower="loadMore">
    <view class="auction-item" wx:for="{{auctions}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="item-image-wrap">
        <image class="item-image" src="{{item.images[0]}}" mode="aspectFill" lazy-load="true"/>
        <view class="item-status {{item.statusClass}}">{{item.statusText}}</view>
        <view class="countdown-badge" wx:if="{{item.status === 1}}">
          <text class="countdown-icon">⏰</text>
          <text class="countdown-text">{{item.countdown}}</text>
        </view>
      </view>
      <view class="item-info">
        <text class="item-title text-ellipsis-2">{{item.title}}</text>
        <view class="item-price-row">
          <view class="current-price">
            <text class="price-label">当前价</text>
            <text class="price-value price">{{item.currentPrice}}</text>
          </view>
          <view class="start-price">
            <text class="price-label">起拍价</text>
            <text class="price-value">¥{{item.startPrice}}</text>
          </view>
        </view>
        <view class="item-meta">
          <text class="bid-count">{{item.bidCount || 0}}次出价</text>
          <text class="increment">加价幅度 ¥{{item.increment}}</text>
        </view>
      </view>
    </view>

    <!-- 加载状态 -->
    <view class="load-status">
      <text wx:if="{{loading}}">加载中...</text>
      <text wx:elif="{{noMore}}">没有更多了</text>
      <text wx:elif="{{auctions.length === 0}}">暂无拍卖商品</text>
    </view>
  </scroll-view>
</view>
